DATABASE_URL="postgresql://sgrd:sgrd@localhost:5432/sgrd"
# Deploy (compose): porta externa da aplicação (default 8081 se ausente).
# APP_PORT="8081"
# Deploy (imagem única): servir o build do frontend na mesma origem.
# SERVE_FRONTEND="false"
# FRONTEND_DIST="/app/frontend-dist"
# Produção (SEC-02): valores contendo "change-me" ou com prefixo "dev-" recusam boot sob NODE_ENV=production.
JWT_ACCESS_SECRET="change-me-access-32chars-min"
# Produção (SEC-02): valores contendo "change-me" ou com prefixo "dev-" recusam boot sob NODE_ENV=production.
JWT_REFRESH_SECRET="change-me-refresh-32chars-min"
SMTP_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SGRD <nao-responder@utfpr.edu.br>"
SMTP_ENC_KEY="0123456789abcdef0123456789abcdef"
# Produção (SEC-02): exige sufixo institucional @utfpr.edu.br; demais domínios recusam boot sob NODE_ENV=production.
INITIAL_ADMIN_EMAIL="ldsampaio@utfpr.edu.br"
# Produção (SEC-02): vazio, contendo "change-me" ou com prefixo "dev-" recusa boot sob NODE_ENV=production.
INITIAL_ADMIN_TEMPORARY_PASSWORD=""
PORT="3000"
# Produção (SEC-04): usar o host público https exato, sem barra final (ex.: https://exemplo.utfpr.edu.br).
FRONTEND_URL="http://localhost:5173"
# Produção (SEC-04): produção usa "true"; desenvolvimento local usa "false" (localhost sem Secure).
COOKIE_SECURE="false"
