DATABASE_URL="postgresql://sgrd:sgrd@localhost:5432/sgrd"
# Deploy (compose): porta externa da aplicação (default 8081 se ausente).
# APP_PORT="8081"
# Deploy (imagem única): servir o build do frontend na mesma origem.
# SERVE_FRONTEND="false"
# FRONTEND_DIST="/app/frontend-dist"

# ── Contrato de sessão (docs/session-contract.md) ──
# O sgrf não autentica credencial: ele confirma no Redis que a sessão do saga está
# viva. Não há segredo de JWT próprio nem senha de admin — o que precisa ser seguro
# é o acesso ao Redis (ACL read-only) e o JWKS do saga.
# Produção (SEC-02): vazio, "change-me" ou prefixo "dev-" recusam boot.
# REDIS_URL: produção (SEC-02) exige o usuário ACL saga_readonly — o sgrf nunca
# escreve no store de sessões.
REDIS_URL="redis://saga_readonly:saga-dev-ro@localhost:6379/0"
SAGA_JWKS_URL="http://localhost:8000/.well-known/jwks.json"
SAGA_LOGIN_URL="http://localhost:8000/login"
# Allowlist explícita para o `redirect` de login_url. Sem allowlist o middleware
# não monta redirect (open redirect). Host sem porta.
PORTAL_ALLOWED_REDIRECT_HOSTS="localhost"
# Cookie compartilhado do saga — o sgrf nunca define cookie próprio.
SESSION_COOKIE_NAME="saga_session"

# Seed: só o PAPEL do admin em sgrf.user_roles. A identidade é criada pelo saga no
# primeiro login; o sgrf não cria usuário nem credencial.
INITIAL_ADMIN_LOGIN="ldsampaio"

SMTP_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SGRD <nao-responder@utfpr.edu.br>"
SMTP_ENC_KEY="0123456789abcdef0123456789abcdef"

PORT="3000"
# Produção (SEC-04): usar o host público https exato, sem barra final.
FRONTEND_URL="http://localhost:5173"
